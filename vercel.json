{
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/salaries", "destination": "/salaries.html" },
    { "source": "/(.*\\.html)", "destination": "/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
